# Copy to .env.local for local dev. NEVER commit .env.local (gitignored).
# All values come from the free accounts listed in plan.md §1.

# --- Google OAuth (console.cloud.google.com → Credentials → OAuth client) ---
# Redirect URI to add: {SITE_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin access ---
# Comma-separated emails allowed to log in (layer 2 security)
ADMIN_EMAILS=you@gmail.com
# Email address that receives the OTP (use a DIFFERENT email than your Google
# account — same inbox would make the OTP useless)
OTP_EMAIL=otp@yourdomain.com

# --- Resend (resend.com) — sends the OTP email ---
RESEND_API_KEY=

# --- Turso database (turso.tech) — libSQL ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudinary (cloudinary.com) — audio + covers ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Session ---
# Long random string used to sign the admin session JWT (generate: openssl rand -base64 32)
AUTH_SECRET=

# --- Site ---
# e.g. http://localhost:3000 locally, https://virus404beats.vercel.app in production
SITE_URL=http://localhost:3000